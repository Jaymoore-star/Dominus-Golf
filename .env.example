# Backend API base URL. Leave unset to use the hosted backend.
# For local backend testing: VITE_BACKEND_URL=http://127.0.0.1:8787
# VITE_BACKEND_URL=

# Supabase auth — get these from Supabase → Settings → API
# Safe for the frontend (anon/public key only). NEVER put the service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
