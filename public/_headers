# Cache-Control overrides for Workers Static Assets.
#
# Cloudflare's default for every asset is `public, max-age=0, must-revalidate`,
# which means a returning visitor revalidates the ~279 KB JS bundle on every
# single visit instead of reading it from disk. Rules here override that default.
#
# Syntax: a path pattern on its own line, then INDENTED header name/value pairs.
# Limits: 100 rules, 2,000 characters per line.

# Vite writes content-hashed filenames here (index-BATQLzSO.js), so the contents
# behind a given URL can never change — a new build produces a new filename.
# That is precisely the case `immutable` exists for: the browser reuses the file
# for a year without so much as a revalidation request, and a deploy is picked up
# because index.html points at a different name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images deliberately get a SHORT cache, not `immutable`.
#
# These filenames only look content-hashed — `IMG_20251125_140842__6f9f5d69.webp`
# keeps that suffix from its original download, and its contents were replaced in
# commit 2ab1b1d (975 KB -> 90 KB) under the same name. Marking these immutable
# would pin a stale image in every returning visitor's browser for a year with no
# way to bust it short of renaming the file. One day is the compromise.
/images/*
  Cache-Control: public, max-age=86400

# Share images are read by crawlers rather than browsers, and are regenerated by
# `npm run og:images` under stable names, so they get the same treatment.
/og-default.jpg
  Cache-Control: public, max-age=86400

# HTML is deliberately absent from this file. Every prerendered *.html must keep
# revalidating, or a deploy would not reach anyone holding a cached copy — the
# HTML is what points at the new hashed asset filenames. Cloudflare's default for
# documents, `public, max-age=0, must-revalidate`, already does that.
#
# DO NOT add a `/*` rule to force `no-cache` on documents. It was tried on
# 2026-07-31 and reverted, because these rules MERGE rather than override —
# verified with `npx wrangler dev`:
#
#   /assets/index-BzGe2PpN.js -> no-cache, public, max-age=31536000, immutable
#
# Both land on the same response and `no-cache` wins for freshness, so every
# returning visitor would revalidate the whole JS bundle on every page view —
# precisely what the /assets rule above exists to prevent. There is no negation
# syntax, so a catch-all cannot exclude /assets.
#
# If a stale document ever needs forcing out of browsers, do it in the app: fetch
# a small uncached version file on load and reload when it differs from the build.
